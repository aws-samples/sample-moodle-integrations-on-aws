#!/usr/bin/env bash
#MISE description="Check rendered deployment policies against the IAM size limit and IAM Access Analyzer"
#MISE depends=["policy:render"]
set -euo pipefail

# IAM counts managed policy size without whitespace
MAX_POLICY_CHARS=6144
failed=0
for policy in cdk.out/deployment-policies/*.json; do
  size=$(tr -d '[:space:]' < "$policy" | wc -c | tr -d ' ')
  echo "$policy: $size / $MAX_POLICY_CHARS characters"
  if [ "$size" -gt "$MAX_POLICY_CHARS" ]; then echo "  too large for a managed policy"; failed=1; fi
  if grep -Eq '"[a-z0-9-]+:[*]"' "$policy"; then echo "  contains a service-wide wildcard action"; failed=1; fi
  aws accessanalyzer validate-policy --policy-type IDENTITY_POLICY --policy-document "file://$policy" --query 'findings[].[findingType,issueCode,findingDetails]' --output text
  blocking=$(aws accessanalyzer validate-policy --policy-type IDENTITY_POLICY --policy-document "file://$policy" --query "length(findings[?findingType=='ERROR' || findingType=='SECURITY_WARNING'])" --output text)
  if [ "$blocking" != "0" ]; then echo "  Access Analyzer reported $blocking error(s) or security warning(s)"; failed=1; fi
done
exit $failed
