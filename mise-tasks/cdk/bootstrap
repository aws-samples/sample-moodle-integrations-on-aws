#!/usr/bin/env bash
#MISE description="Bootstrap CDK toolkit stack"
#MISE depends=["site:build"]
set -euo pipefail

if [ -n "${POLICY_ARN:-}" ]; then
  echo "Using least privilege policy: $POLICY_ARN"
  cdk bootstrap --qualifier "$QUALIFIER" --cloudformation-execution-policies "$POLICY_ARN" --toolkit-stack-name "CDKToolkit-${STACK_NAME}"
else
  echo "Using default AdministratorAccess policy (run 'mise run policy:deploy' for least privilege)"
  cdk bootstrap --qualifier "$QUALIFIER" --toolkit-stack-name "CDKToolkit-${STACK_NAME}"
fi
